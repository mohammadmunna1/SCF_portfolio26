# Copy to .env and fill in. Never commit .env.

# --- Database (required for the admin panel) --------------------------------
# MongoDB Atlas (free tier works) or a local MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
# The Atlas account (login email) that owns the database, shown at the top of the admin panel
# MONGODB_ACCOUNT_EMAIL=you@gmail.com

# --- Admin authentication -----------------------------------------------------
# Long random string (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# The first admin account is created from these on first start (min 10 chars).
# You can remove ADMIN_PASSWORD afterwards and change it from the admin panel.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# How long an admin stays signed in, in days (default 7)
# SESSION_DAYS=7

# --- API server ---------------------------------------------------------------
PORT=3001
# Only needed if the site and the API run on different domains:
# CORS_ORIGINS=https://your-site.vercel.app
# COOKIE_SAMESITE=none

# --- Optional: email notifications for contact-form messages ------------------
# (Messages are always stored in the admin inbox. The site also forwards them via Web3Forms.)
EMAIL_USER=
EMAIL_PASS=
# CONTACT_RECEIVER=you@example.com
# NOTIFY_EMAIL_ON_MESSAGE=true

# --- Frontend (exposed to the browser) ----------------------------------------
# Only if the API is hosted on a different origin than the site:
# VITE_API_URL=https://your-api.example.com
# Web3Forms access key used by the contact form (public by design)
# VITE_WEB3FORMS_KEY=
