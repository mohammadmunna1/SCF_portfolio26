# Secrets: environment files (database URI, JWT secret, passwords) and keys.
# Only the template .env.example, which holds no real values, is committed.
.env
.env.*
!.env.example
*.pem

# Private full backups (npm run backup -- --full, npm run restore -- --all) — never commit them
backups/
